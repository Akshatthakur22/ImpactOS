# Local development only. Never point this at production while bootstrapping.
DATABASE_URL=postgresql://sportdesk:sportdesk_dev_only@localhost:5432/sportdesk
JWT_ACCESS_SECRET=
WEB_ORIGIN=http://localhost:3000
PORT=4000
NODE_ENV=development
TRUST_PROXY_HOPS=0
SESSION_TTL_DAYS=30
ACCESS_TOKEN_TTL_MINUTES=15
# Optional account recovery email delivery through Resend. Password reset requests
# remain unavailable until both values are configured.
RESEND_API_KEY=
EMAIL_FROM=
# Optional public website inquiry intake. Keep the academy ID on the server;
# never include it in the submitted form body. The key is used for idempotency.
PUBLIC_ADMISSIONS_ACADEMY_ID=
PUBLIC_ADMISSIONS_WEB_ORIGIN=
# Optional mobile push registration. Set the EAS project ID and build a native
# development/production client with Apple/Google push credentials for delivery.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Required only by the explicit local bootstrap command.
ACADEMY_NAME=Impact Fit Academy
ACADEMY_SLUG=impact-fit-academy
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_NAME=
BOOTSTRAP_OWNER_PASSWORD=
