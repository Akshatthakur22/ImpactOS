{
  "name": "sportdesk",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @sportdesk/backend --filter @sportdesk/admin dev",
    "dev:api": "pnpm --filter @sportdesk/backend dev",
    "dev:admin": "pnpm --filter @sportdesk/admin dev",
    "dev:mobile": "pnpm --filter @sportdesk/mobile start",
    "build": "pnpm -r --workspace-concurrency=1 --if-present build",
    "typecheck": "pnpm -r --workspace-concurrency=1 --if-present typecheck",
    "lint": "eslint .",
    "test": "pnpm -r --if-present test",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.48.0"
  }
}
